+  private nativeMemory(): NativeMemoryQueue | undefined {
+    if (this.#nativeMemoryQueue !== undefined) return this.#nativeMemoryQueue ?? undefined;
+    const config = readNativeMemoryConfig(this.env);
+    if (!config) { this.#nativeMemoryQueue = null; return; }
+    const author = (principal: string): AiChatAuthorInfo => ({ type: 'user', id: principal, name: 'Memory synchronization' });
+    this.#nativeMemoryQueue = new NativeMemoryQueue({ ...config, workspaceId: this.ctx.id.toString(),
+      binding: (this.env as unknown as { OS_AGENT_MEMORY?: NativeMemoryBinding }).OS_AGENT_MEMORY,
+      store: {
+        get: chatId => this.storage.nativeMemory.get(chatId),
+        put: state => { this.storage.nativeMemory.put(state); },
+        delete: chatId => { this.storage.nativeMemory.delete(chatId); },
+        list: () => [...this.storage.nativeMemory.list()],
+        transaction: callback => this.ctx.storage.transactionSync(callback),
+      },
+      source: createMemorySource({
+        assertAccess: (chatId, principal) => this.assertNativeMemoryAccess(chatId, principal),
+        record: (chatId, sequence) => this.storage.chats.get(chatKey(chatId, sequence)),
+        history: (chatId, sequence, principal) => this.readChatHistoryPage(chatId, sequence, author(principal)),
+        readText: (chatId, artifactId, cursor, principal) => this.readChatText(chatId, artifactId,
+          { cursor, maxBytes: 4096 }, author(principal)),
+        archive: (chatId, text) => this.archiveChatText(chatId, text),
+        attachment: (chatId, id) => this.getChatAttachmentData(chatId, id),
+        isTextAttachment: isTextLikeAttachmentMimeType,
+      }),
+    });
+    return this.#nativeMemoryQueue;
+  }
+
+  private assertNativeMemoryAccess(chatId: number, principal: string): void {
+    const config = readNativeMemoryConfig(this.env);
+    const state = this.storage.nativeMemory.get(chatId);
+    this.getChatMetaOrThrow(chatId);
+    if (!config || config.principal !== principal || state?.principal !== principal || state.namespace !== config.namespace) {
+      throw new Error('Native bot memory is not authorized for this account or deployment.');
+    }
+  }
+
+  private enrollNativeMemory(clientUser: DurableObjectStub<UserDurableObject>, userMeta: UserChatContext, chatId: number): void {
+    const config = readNativeMemoryConfig(this.env);
+    if (!config || accountIdForTrustedAgentAuthor(userMeta.profile) !== config.principal ||
+        clientUser.id.toString() !== this.ownerId) return;
+    const botId = this.getChatMetaOrThrow(chatId).bot?.id ?? null;
+    this.nativeMemory()!.enroll(chatId, botId, this.storage.nextChatSequences.get(chatId)?.nextSequence ?? 0);
+  }
+
+  nativeMemoryEnabled(chatId: number, initiator: AiChatAuthorInfo): boolean {
+    const config = readNativeMemoryConfig(this.env);
+    return !!config && accountIdForTrustedAgentAuthor(initiator) === config.principal &&
+      this.storage.nativeMemory.get(chatId)?.principal === config.principal && !!this.storage.chatMeta.get(chatId);
+  }
+
+  async searchBotMemory(chatId: number, initiator: AiChatAuthorInfo, query: string,
+      options: MemorySearchOptions = {}): Promise<MemorySearchResponse> {
+    if (!this.nativeMemoryEnabled(chatId, initiator)) throw new Error('Native bot memory is unavailable.');
+    this.assertNativeMemoryAccess(chatId, initiator.id);
+    if (!this.ownerId) throw new Error('No verified owner for memory search.');
+    const owner = this.users.get(this.users.idFromString(this.ownerId));
+    const bots = await owner.listBotProfiles();
+    this.assertNativeMemoryAccess(chatId, initiator.id);
+    const state = this.storage.nativeMemory.get(chatId)!;
+    const binding = (this.env as unknown as { OS_AGENT_MEMORY?: NativeMemoryBinding }).OS_AGENT_MEMORY;
+    if (!binding) throw new Error('Native Agent Memory binding missing.');
+    const result = await searchMemoryProfiles({
+      principal: state.principal, currentBotId: state.botId,
+      bots, query, options, binding,
+      profileName: id => memoryProfileName(state.principal, id),
+      commonName: () => commonMemoryProfileName(state.principal),
+    });
+    this.assertNativeMemoryAccess(chatId, initiator.id);
+    return result;
+  }
+
+  async listBotMemorySources(chatId: number, initiator: AiChatAuthorInfo) {
+    if (!this.nativeMemoryEnabled(chatId, initiator)) throw new Error('Native bot memory is unavailable.');
+    this.assertNativeMemoryAccess(chatId, initiator.id);
+    if (!this.ownerId) throw new Error('No verified owner for memory search.');
+    const owner = this.users.get(this.users.idFromString(this.ownerId));
+    const bots = await owner.listBotProfiles();
+    this.assertNativeMemoryAccess(chatId, initiator.id);
+    return bots.map(bot => ({ id: bot.id, name: bot.name, archived: bot.archived }));
+  }
+
+  memorySyncStatus(chatId: number, initiator: AiChatAuthorInfo): NativeMemoryStatus {
+    if (!this.nativeMemoryEnabled(chatId, initiator)) throw new Error('Native bot memory is unavailable.');
+    this.assertNativeMemoryAccess(chatId, initiator.id);
+    return this.nativeMemory()!.status(chatId);
+  }
