+describe('account catalog revocation in existing selections', () => {
+  it('revokes missing default and physical choices in quick models and persisted gadget bindings', async () => {
+    await setModes({});
+    const accountModels = [defaultModel, physical.id].map(id => ({ id,
+      name: Object.values(OPENAI_MODELS).find(model => model.id === id)!.name }));
+    let currentModels = accountModels;
+    const accountDeployment = { ...deployment, CODEX_BRIDGE: { ...deployment.CODEX_BRIDGE,
+      async subscriptionModels() { return { source: 'subscription-provider-catalog', connections: [{
+        ...connection, source: 'provider-account-catalog', entitlementVerified: true, models: currentModels,
+      }] }; },
+    } };
+    const before = inputs.length;
+    async function inUser(action: (user: import('../src/user').UserDurableObject) => Promise<void>) {
+      await runInDurableObject(env.TEST_USER.getByName(userId), async user => {
+        const original = user.env;
+        user.env = accountDeployment;
+        try {
+          await user.loginOrCreateViaGatekeeper(userId, true);
+          await action(user);
+        } finally {
+          user.env = original;
+        }
+      });
+    }
+    for (const selected of [defaultModel, selectedId]) {
+      currentModels = accountModels;
+      const models = new SubscriptionModels(accountDeployment, DEFAULT_ADMIN_CONFIG, userId,
+        await readSubscriptionConnections(accountDeployment));
+      const record = models.resolve(selected)!;
+      await inUser(async user => {
+        await user.setQuickModel(selected);
+        expect(await user.getQuickModel()).toBe(selected);
+      });
+      const startBinding = () => runInDurableObject(env.TEST_USER_DIRECTORY.getByName(`account-revocation-${selected}`), async (_host, state) => {
+        Object.defineProperty(state, 'props', { configurable: true, value: {
+          displayName: record.profile.name, config: record.config,
+          initiator: { type: 'gadget', id: userId, name: 'Synthetic workspace' },
+        } });
+        await new LanguageModelGatekeeper(state, accountDeployment).startSession(undefined!);
+      });
+      await expect(startBinding()).resolves.toBeUndefined();
+      currentModels = accountModels.filter(model => model.id !== record.config.model);
+      await inUser(async user => {
+        expect((await user.listModels()).map(model => model.id)).not.toContain(selected);
+        expect(await user.getQuickModel()).toBeNull();
+        expect((await user.getChatContext(null)).quickModel).toBeUndefined();
+        await expect(user.setQuickModel(selected)).rejects.toThrow('No such model');
+        await expect(user.getChatContext(selected)).rejects.toThrow('No such model');
+      });
+      await expect(startBinding()).rejects.toThrow('Unknown subscription connection');
+    }
+    expect(inputs).toHaveLength(before);
+  });
+});
