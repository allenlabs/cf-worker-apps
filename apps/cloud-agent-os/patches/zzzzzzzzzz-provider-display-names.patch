new file mode 100644
index 0000000..46094f7
--- /dev/null
+++ b/packages/workshop-frontend/src/features/ai-models/DisplayNameEditor.tsx
@@ -0,0 +1,34 @@
+import { useState, type FormEvent } from 'react'
+import { Button, Input } from '@cloudflare/kumo'
+import { validateDisplayName } from '@gadgets/workshop-shared/api'
+
+export function DisplayNameEditor({ label, name, busy, onSave }: {
+  label: string
+  name: string
+  busy: boolean
+  onSave: (name: string | null) => void
+}) {
+  const [draft, setDraft] = useState<string | null>(null)
+  const [error, setError] = useState<string>()
+  const submit = (event: FormEvent) => {
+    event.preventDefault()
+    if (busy) return
+    try {
+      const value = draft ?? name
+      const saved = value === '' ? null : validateDisplayName(value)
+      onSave(saved)
+      setDraft(null)
+      setError(undefined)
+    } catch (error) {
+      setError(error instanceof Error ? error.message : 'Invalid display name')
+    }
+  }
+  return (
+    <form onSubmit={submit} className="mt-2 flex flex-wrap items-end gap-2">
+      <Input label={label} value={draft ?? name} disabled={busy}
+        description="Leave blank to restore the default name."
+        error={error} onChange={event => { setDraft(event.target.value); setError(undefined) }} />
+      <Button type="submit" size="sm" variant="secondary" disabled={busy}>Save name</Button>
+    </form>
+  )
+}
