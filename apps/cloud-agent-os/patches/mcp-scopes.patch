+describe("deployment OAuth scope policy", () => {
+  it.each([true, false])("uses explicit read scopes ahead of advertised write scopes: %s", async configured => {
+    const context = fakeContext();
+    const complete = vi.fn(async () => HANDOFF);
+    stubOAuthServer();
+    const originalFetch = globalThis.fetch;
+    let registrationScope: unknown;
+    vi.stubGlobal("fetch", async (input: string, init?: RequestInit) => {
+      const url = String(input);
+      if (url === "https://auth.example/register") {
+        registrationScope = JSON.parse(String(init?.body)).scope;
+      }
+      const response = await originalFetch(input, init);
+      if (url.includes("oauth-protected-resource")) {
+        const document: unknown = await response.json();
+        if (!document || typeof document !== "object") throw new Error("Invalid test metadata");
+        return Response.json({ ...document, scopes_supported: ["openid", "example.read", "example.write"] });
+      }
+      return response;
+    });
+    const env = configured ? { MCP_OAUTH_SCOPES: JSON.stringify({
+      "https://mcp.example/mcp": ["openid", "example.read"],
+    }) } : {};
+    const nonce = "8".repeat(64);
+    const account = new OAuthFlowAccount(context as never, env);
+    await account.setCallback({ complete } as never, nonce);
+    const outcome = await account.beginConnect(nonce, server("https://mcp.example/mcp"));
+    if (outcome.kind !== "redirect") throw new Error("Expected OAuth redirect");
+    const redirect = new URL(outcome.url);
+    expect(redirect.searchParams.get("scope")).toBe(configured
+      ? "openid example.read" : "openid example.read example.write");
+    expect(registrationScope).toBe(configured ? "openid example.read" : "openid example.read example.write");
+    const state = redirect.searchParams.get("state");
+    if (!state) throw new Error("Expected OAuth state");
+    const resumed = new OAuthFlowAccount(context as never, env);
+    expect(await resumed.acceptAuthCode("authorization-code", state.slice(state.indexOf(":") + 1))).toEqual(HANDOFF);
+    expect(complete).toHaveBeenCalledOnce();
+  });
+});
