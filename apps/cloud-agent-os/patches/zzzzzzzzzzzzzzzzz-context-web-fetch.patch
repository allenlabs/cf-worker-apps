+
+describe("webFetch complete response limit", () => {
+  const originalFetch = globalThis.fetch;
+  afterEach(() => { globalThis.fetch = originalFetch; });
+
+  it("rejects an oversized response rather than returning its prefix as a successful fetch", async () => {
+    let cancelled = false;
+    let position = 0;
+    const chunks = [new TextEncoder().encode('kept'), new TextEncoder().encode(' omitted')];
+    globalThis.fetch = vi.fn(async () => new Response(new ReadableStream({
+      pull(controller) {
+        const chunk = chunks[position++];
+        if (chunk) controller.enqueue(chunk);
+      },
+      cancel() { cancelled = true; },
+    }), { headers: { 'content-type': 'text/plain' } })) as typeof fetch;
+    await expect(webFetch(makeEnv(), { url: 'https://example.com/large', maxBytes: 4 }))
+        .rejects.toThrow(/exceeds.*4.*bytes/i);
+    expect(cancelled).toBe(true);
+  });
+
+  it("retains every Unicode character for a response exactly at the byte limit", async () => {
+    globalThis.fetch = vi.fn(async () => new Response('🧭')) as typeof fetch;
+    const result = await webFetch(makeEnv(), { url: 'https://example.com/exact', maxBytes: 4 });
+    expect(result.body).toBe('🧭');
+    expect(result.truncated).toBe(false);
+  });
+
+  it("does not convert an incomplete document", async () => {
+    globalThis.fetch = vi.fn(async () => new Response('<html>long document</html>', {
+      headers: { 'content-type': 'text/html' },
+    })) as typeof fetch;
+    const toMarkdown = vi.fn(async () => { throw new Error('Incomplete document reached converter'); });
+    await expect(webFetch(makeEnv(toMarkdown), { url: 'https://example.com/document', maxBytes: 4 }))
+        .rejects.toThrow(/exceeds.*4.*bytes/i);
+  });
+
+  it.each([NaN, Infinity, -1, 0])("rejects an invalid byte limit (%s) before fetching", async maxBytes => {
+    globalThis.fetch = vi.fn(async () => { throw new Error('Invalid limit reached network'); }) as typeof fetch;
+    await expect(webFetch(makeEnv(), { url: 'https://example.com/invalid', maxBytes }))
+        .rejects.toThrow(/byte limit must/i);
+  });
+});
+
+describe("webFetch exact UTF-8 text", () => {
+  const originalFetch = globalThis.fetch;
+  afterEach(() => { globalThis.fetch = originalFetch; });
+
+  it.each([
+    { raw: true, contentType: 'text/html' },
+    { raw: false, contentType: 'text/plain' },
+    { raw: false, contentType: 'application/json' },
+  ])("rejects invalid UTF-8 instead of silently replacing bytes (%j)", async ({ raw, contentType }) => {
+    // The lead byte is followed by ASCII instead of a continuation byte.
+    globalThis.fetch = vi.fn(async () => new Response(new Uint8Array([0x61, 0xc3, 0x28]), {
+      headers: { 'content-type': contentType },
+    })) as typeof fetch;
+    await expect(webFetch(makeEnv(), { url: 'https://example.com/malformed', raw }))
+        .rejects.toThrow(/invalid UTF-8/i);
+  });
+
+  it.each([true, false])("preserves the UTF-8 BOM in a complete text passthrough (raw=%s)", async raw => {
+    const original = new Uint8Array([0xef, 0xbb, 0xbf, 0x41, 0xf0, 0x9f, 0xa7, 0xad]);
+    globalThis.fetch = vi.fn(async () => new Response(original, {
+      headers: { 'content-type': 'text/plain' },
+    })) as typeof fetch;
+    const result = await webFetch(makeEnv(), { url: 'https://example.com/bom', raw });
+    expect(result.body).toBe('\ufeffA🧭');
+    expect(new TextEncoder().encode(result.body)).toEqual(original);
+    expect(result.truncated).toBe(false);
+  });
+});
