{
  "name": "cloud-agent",
  "main": "index.js",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "TENANT_ID": "default",
    "TENANT_NAME": "Example workspace",
    "PROBE_MODE": "subscription",
    "OPENAI_MODEL": "gpt-6.1-sol",
    "CHANNEL_REPLY_ENABLED": "false",
    "VISIT_MCP_GROUP_ID": "",
    "IMAGE_ENABLED": "false",
    "IMAGE_CHANNEL_DELIVERY_ENABLED": "false",
    "IMAGE_PROVIDER": "codex",
    "IMAGE_MODEL": "gpt-image-2",
    "PRODUCT_NAME": "Cloud Agent",
    "PUBLIC_ORIGIN": "https://cloud-agent.example.invalid",
    "SSO_ISSUER": "https://sso.example.invalid",
    "SSO_CLIENT_ID": "",
    "SUPER_ADMIN_EMAILS": "[]",
    "SUPER_ADMIN_SUBJECTS": "{}",
    "DIAGNOSTIC_READS_ENABLED": "false",
    "ALLOWED_OPENAI_MODELS": "[\"gpt-6-luna\", \"gpt-6.1-sol\", \"gpt-6-astra\"]",
    "ALLOWED_CHANNEL_ID": "",
    "ALLOWED_CHAT_ID": "",
    "CHANNEL_APP_ID": "",
    "OWNER_EMAIL_SHA256": "",
    "TOKEN_WRAPPING_AAD": "cloud-agent/v1",
    "GITHUB_APP_ID": "",
    "GITHUB_APP_CLIENT_ID": "",
    "GITHUB_INSTALLATION_ID": "",
    "GITHUB_INSTALLATION_OWNER": ""
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "d1_databases": [{ "binding": "CONVERSATIONS", "database_name": "cloud-agent-conversations-example", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "durable_objects": {
    "bindings": [
      {
        "name": "Assistant",
        "class_name": "Assistant"
      },
      {
        "name": "Credentials",
        "class_name": "Credentials"
      },
      {
        "name": "GitHubAuthoring",
        "class_name": "GitHubAuthoring"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Assistant",
        "Credentials"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "GitHubAuthoring"
      ]
    }
  ]
}
