    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "4.1.7",
    "jsdom": "^25.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.7.2",
    "vitest": "4.1.7"
