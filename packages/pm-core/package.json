{
  "name": "@allenlabs/pm-core",
  "version": "0.0.0",
  "description": "Reusable core for the Allen Labs project-management suite — schema, pure server-side logic, the plugin host, the auth-adapter seam, and shared utilities. Consumed source-level by a thin TanStack Start app.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./db/*": "./src/db/*.ts",
    "./testing/db": "./src/testing/db.ts"
  },
  "files": ["src", "drizzle-pg"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@tanstack/react-start": ">=1.168.0",
    "drizzle-orm": ">=0.45.0",
    "postgres": ">=3.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@electric-sql/pglite": "^0.4.0",
    "@tanstack/react-start": "^1.168.14",
    "@vitest/coverage-v8": "4.1.7",
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.5",
    "typescript": "5.7.2",
    "vitest": "4.1.7"
  }
}
